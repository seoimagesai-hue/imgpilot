{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-about-verify/types/**/*.ts",
    ".next-bulk-compress-verify/types/**/*.ts",
    ".next-bulk-convert-verify/types/**/*.ts",
    ".next-bulk-resize-verify/types/**/*.ts",
    ".next-compress-image-verify/types/**/*.ts",
    ".next-compress-webp-verify/types/**/*.ts",
    ".next-convert-image-verify/types/**/*.ts",
    ".next-crop-image-verify/types/**/*.ts",
    ".next-crop-png-verify/types/**/*.ts",
    ".next-crop-webp-verify/types/**/*.ts",
    ".next-eeat-verify/types/**/*.ts",
    ".next-i18n-verify/types/**/*.ts",
    ".next-p3-verify/types/**/*.ts",
    ".next-phase1-verify/types/**/*.ts",
    ".next-png-to-webp-verify/types/**/*.ts",
    ".next-resize-image-verify/types/**/*.ts",
    ".next-resize-webp-verify/types/**/*.ts",
    ".next-webp-to-png-verify/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-img-pilot/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    ".next"
  ]
}
