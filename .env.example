# Public application URL. Safe to expose to the browser.
# Used for absolute links and Auth.js callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public support contact (shown on /contact). Leave empty if unset.
SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Drizzle)
# Required for registration, login lookups, and Auth.js adapter writes.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js
# Generate AUTH_SECRET with:
#   openssl rand -base64 32
#   or: npx auth secret
# AUTH_SECRET must be at least 32 characters.
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth — both values required to enable Google sign-in.
# Leave both empty to keep Google sign-in disabled in the UI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare R2 private object storage
# Leave ALL empty to keep uploads disabled, OR set ALL of:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_ENDPOINT
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Keep the bucket private. Apply CORS from docs/r2-cors.example.json
# TTL seconds allowed range: 60–900 (default 300)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Consumer guest foundation (Redesign v2 Phase 1) — optional overrides
# Defaults: cookie seoimages_guest, 10MB, 5 ops/24h, 1 hour asset TTL
# -----------------------------------------------------------------------------
GUEST_COOKIE_NAME=seoimages_guest
GUEST_MAX_FILE_BYTES=10485760
GUEST_MAX_OPS_PER_DAY=5
GUEST_ASSET_TTL_HOURS=1

# -----------------------------------------------------------------------------
# AI metadata (Prompt 17) — server-only. Leave empty to disable AI.
# Set AI_PROVIDER=openai and OPENAI_API_KEY together, or leave both empty.
# Interface language ≠ metadata output language (projects.metadata_language).
# Worker required: npm run worker:processing
# -----------------------------------------------------------------------------
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=60
AI_METADATA_PROMPT_VERSION=metadata-v1

# -----------------------------------------------------------------------------
# Stripe billing (Prompt 21) — server-only secrets. Leave empty to disable.
# STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET must both be set, or both empty.
# Paid checkout stays disabled until Price IDs below are configured (no invented prices).
# Webhook: POST /api/billing/webhook
# Stripe CLI: stripe listen --forward-to localhost:3000/api/billing/webhook
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=

# Guest cleanup HTTP cron (POST /api/internal/cron/cleanup). Header: x-cron-secret
CRON_SECRET=
# Optional alias for CRON_SECRET
CLEANUP_CRON_SECRET=

# -----------------------------------------------------------------------------
# WordPress integration (Prompt 26) — server-only. Leave empty for defaults.
# INTEGRATION_ENCRYPTION_KEY: optional base64 (≥32 bytes when decoded). If empty,
# WordPress credentials fall back to an AUTH_SECRET-derived key (same pattern as
# webhook secret encryption). Never put real Application Passwords here.
# -----------------------------------------------------------------------------
INTEGRATION_ENCRYPTION_KEY=
WORDPRESS_REQUEST_TIMEOUT_SECONDS=
WORDPRESS_MAX_RESPONSE_BYTES=
WORDPRESS_MAX_CONCURRENT_PUBLISHES=
WORDPRESS_PUBLISH_RETRY_LIMIT=

# -----------------------------------------------------------------------------
# Shopify integration (Prompt 27) — server-only. Leave empty for defaults.
# Auth is a Custom App Admin API access token only (no OAuth). The token is
# encrypted at rest using the same INTEGRATION_ENCRYPTION_KEY as WordPress.
# Never put a real access token here.
# -----------------------------------------------------------------------------
SHOPIFY_REQUEST_TIMEOUT_SECONDS=
SHOPIFY_MAX_RESPONSE_BYTES=
SHOPIFY_MAX_CONCURRENT_PUBLISHES=
SHOPIFY_PUBLISH_RETRY_LIMIT=

# -----------------------------------------------------------------------------
# Webflow integration (Prompt 28) — server-only. Leave empty for defaults.
# Auth is a Site access token only (no OAuth). The token is encrypted at rest
# using the same INTEGRATION_ENCRYPTION_KEY as WordPress/Shopify.
# Never put a real access token here.
# -----------------------------------------------------------------------------
WEBFLOW_REQUEST_TIMEOUT_SECONDS=
WEBFLOW_MAX_RESPONSE_BYTES=
WEBFLOW_MAX_CONCURRENT_PUBLISHES=
WEBFLOW_PUBLISH_RETRY_LIMIT=

