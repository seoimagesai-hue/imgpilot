# Public application URL. Safe to expose to the browser.
# Used for absolute links and Auth.js callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Drizzle)
# Required for registration, login lookups, and Auth.js adapter writes.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js
# Generate AUTH_SECRET with:
#   openssl rand -base64 32
#   or: npx auth secret
# AUTH_SECRET must be at least 32 characters.
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth — both values required to enable Google sign-in.
# Leave both empty to keep Google sign-in disabled in the UI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare R2 private object storage
# Leave ALL empty to keep uploads disabled, OR set ALL of:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_ENDPOINT
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Keep the bucket private. Apply CORS from docs/r2-cors.example.json
# TTL seconds allowed range: 60–900 (default 300)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Future: AI metadata providers (interface language ≠ metadata output language)
# -----------------------------------------------------------------------------
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Future: Stripe billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
