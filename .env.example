# Public application URL. Safe to expose to the browser.
# Used for absolute links and Auth.js callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Drizzle)
# Required for registration, login lookups, and Auth.js adapter writes.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js
# Generate AUTH_SECRET with:
#   openssl rand -base64 32
#   or: npx auth secret
# AUTH_SECRET must be at least 32 characters.
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth — both values required to enable Google sign-in.
# Leave both empty to keep Google sign-in disabled in the UI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Future: Cloudflare R2 object storage
# Original uploads and optimized outputs will use separate key prefixes.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Future: AI metadata providers (interface language ≠ metadata output language)
# -----------------------------------------------------------------------------
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Future: Stripe billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
