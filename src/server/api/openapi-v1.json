{
  "openapi": "3.1.0",
  "info": {
    "title": "Img Pilot Public API",
    "version": "1",
    "description": "Bearer-authenticated REST API for projects, image uploads, processing, AI metadata, and exports. Every response is a JSON envelope: `{ \"ok\": true, \"data\": ..., \"meta\"?: ..., \"requestId\": ... }` on success, or `{ \"ok\": false, \"error\": { \"code\", \"message\", \"details\"? }, \"requestId\": ... }` on failure. Manage keys and webhooks from Dashboard → Settings → Developer.",
    "contact": {"name": "Img Pilot", "url": "https://seoimages.example.com/docs/api"}
  },
  "servers": [{"url": "https://app.seoimages.example.com/api/v1", "description": "Production"}],
  "security": [{"bearerAuth": []}],
  "tags": [
    {"name": "Projects"},
    {"name": "Images"},
    {"name": "Uploads"},
    {"name": "Processing"},
    {"name": "Metadata"},
    {"name": "Exports"}
  ],
  "paths": {
    "/projects": {
      "get": {
        "tags": ["Projects"],
        "summary": "List projects",
        "description": "Cursor-paginated list of projects accessible to this API key's workspace.",
        "security": [{"bearerAuth": ["projects:read"]}],
        "parameters": [
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["active", "archived", "all"], "default": "active"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}},
          {"name": "cursor", "in": "query", "description": "Opaque cursor from a previous response's `meta.nextCursor`.", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Projects page.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectListEnvelope"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "post": {
        "tags": ["Projects"],
        "summary": "Create a project",
        "description": "Creates a project owned by this API key's workspace (personal or organization).",
        "security": [{"bearerAuth": ["projects:write"]}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateProjectRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Project created.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectEnvelope"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/UnprocessableEntity"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/projects/{projectId}": {
      "get": {
        "tags": ["Projects"],
        "summary": "Get a project",
        "security": [{"bearerAuth": ["projects:read"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}],
        "responses": {
          "200": {"description": "Project.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "patch": {
        "tags": ["Projects"],
        "summary": "Update a project",
        "description": "Full replace of the editable project fields (name, websiteUrl, description, metadataLanguage).",
        "security": [{"bearerAuth": ["projects:write"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateProjectRequest"}}}
        },
        "responses": {
          "200": {"description": "Updated project.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectEnvelope"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/projects/{projectId}/images": {
      "get": {
        "tags": ["Images"],
        "summary": "List images in a project",
        "security": [{"bearerAuth": ["images:read"]}],
        "parameters": [
          {"$ref": "#/components/parameters/ProjectId"},
          {"name": "q", "in": "query", "schema": {"type": "string"}},
          {"name": "status", "in": "query", "schema": {"type": "string"}},
          {"name": "sort", "in": "query", "schema": {"type": "string"}},
          {"name": "view", "in": "query", "schema": {"type": "string"}},
          {"name": "pageSize", "in": "query", "schema": {"type": "integer"}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Images page.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImageListEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/projects/{projectId}/images/{imageId}": {
      "get": {
        "tags": ["Images"],
        "summary": "Get an image",
        "description": "Never returns a storage key — only metadata about the image.",
        "security": [{"bearerAuth": ["images:read"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ImageId"}],
        "responses": {
          "200": {"description": "Image.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImageEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/projects/{projectId}/uploads/authorize": {
      "post": {
        "tags": ["Uploads"],
        "summary": "Authorize direct-to-storage uploads",
        "description": "Returns short-lived signed PUT URLs (up to 500 files per request). Never returns a raw storage key.",
        "security": [{"bearerAuth": ["images:upload"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthorizeUploadsRequest"}}}
        },
        "responses": {
          "200": {"description": "Signed upload targets.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthorizeUploadsEnvelope"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/UnprocessableEntity"}
        }
      }
    },
    "/projects/{projectId}/uploads/{uploadId}/confirm": {
      "post": {
        "tags": ["Uploads"],
        "summary": "Confirm an upload finished",
        "description": "`uploadId` is the image id returned from the authorize step. Emits an `image.uploaded` webhook event.",
        "security": [{"bearerAuth": ["images:upload"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/UploadId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "responses": {
          "200": {"description": "Upload confirmed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfirmUploadEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "410": {"$ref": "#/components/responses/Gone"}
        }
      }
    },
    "/projects/{projectId}/images/{imageId}/processing-jobs": {
      "post": {
        "tags": ["Processing"],
        "summary": "Create a processing job",
        "description": "Queues an optimize/resize/convert job for a validated image. Executes asynchronously via the background worker (responds `202 Accepted`).",
        "security": [{"bearerAuth": ["images:process"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ImageId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateProcessingJobRequest"}}}
        },
        "responses": {
          "202": {"description": "Job queued.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProcessingJobEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/UnprocessableEntity"}
        }
      }
    },
    "/projects/{projectId}/processing-jobs/{jobId}": {
      "get": {
        "tags": ["Processing"],
        "summary": "Get a processing job",
        "description": "Allowed with either `images:process` (the scope that created it) or `images:read`.",
        "security": [{"bearerAuth": ["images:read"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/JobId"}],
        "responses": {
          "200": {"description": "Processing job.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProcessingJobEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/projects/{projectId}/images/{imageId}/metadata": {
      "get": {
        "tags": ["Metadata"],
        "summary": "Get approved metadata",
        "description": "Returns the currently approved AI metadata for an image, optionally for a specific language.",
        "security": [{"bearerAuth": ["metadata:read"]}],
        "parameters": [
          {"$ref": "#/components/parameters/ProjectId"},
          {"$ref": "#/components/parameters/ImageId"},
          {"name": "language", "in": "query", "schema": {"type": "string", "minLength": 2, "maxLength": 10}}
        ],
        "responses": {
          "200": {"description": "Approved metadata.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MetadataEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/projects/{projectId}/images/{imageId}/metadata/history": {
      "get": {
        "tags": ["Metadata"],
        "summary": "List metadata generation history",
        "description": "Most recent 20 AI metadata generation attempts for this image.",
        "security": [{"bearerAuth": ["metadata:read"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ImageId"}],
        "responses": {
          "200": {"description": "Generation history.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/projects/{projectId}/images/{imageId}/metadata-generations": {
      "post": {
        "tags": ["Metadata"],
        "summary": "Generate AI metadata draft",
        "description": "Queues a new AI metadata generation for a human to review and approve. Executes asynchronously (responds `202 Accepted`).",
        "security": [{"bearerAuth": ["metadata:generate"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ImageId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateMetadataGenerationRequest"}}}
        },
        "responses": {
          "202": {"description": "Generation queued.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/UnprocessableEntity"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/projects/{projectId}/exports": {
      "post": {
        "tags": ["Exports"],
        "summary": "Create an export job",
        "description": "Queues a CSV/JSON/ZIP or CMS-ready export package. Executes asynchronously (responds `202 Accepted`). Default source filter is approved metadata.",
        "security": [{"bearerAuth": ["exports:create"]}],
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateExportRequest"}}}
        },
        "responses": {
          "202": {"description": "Export queued.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessEnvelope"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/UnprocessableEntity"}
        }
      }
    },
    "/projects/{projectId}/exports/{exportId}": {
      "get": {
        "tags": ["Exports"],
        "summary": "Get an export job / download URL",
        "description": "Pass `?download=1` to receive a short-lived signed download URL as JSON (never a redirect, never a raw storage key). Without it, returns the export job status.",
        "security": [{"bearerAuth": ["exports:read"]}],
        "parameters": [
          {"$ref": "#/components/parameters/ProjectId"},
          {"$ref": "#/components/parameters/ExportId"},
          {"name": "download", "in": "query", "schema": {"type": "string", "enum": ["1"]}}
        ],
        "responses": {
          "200": {"description": "Export job or download URL.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessEnvelope"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "si_{live|test}_<prefix>_<secret>",
        "description": "Create keys from Dashboard → Settings → Developer → API keys. Example (fake, illustrative only): `si_live_example_a1b2c3d4_9wQxK2mN5pR8tV1yZ4bC7dF0hJ3kL6nP`. Send as `Authorization: Bearer <key>`. Never send keys as a query parameter."
      }
    },
    "parameters": {
      "ProjectId": {"name": "projectId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ImageId": {"name": "imageId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "UploadId": {"name": "uploadId", "in": "path", "required": true, "description": "The image id returned from the upload authorize step.", "schema": {"type": "string", "format": "uuid"}},
      "JobId": {"name": "jobId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ExportId": {"name": "exportId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Required on every write (POST) request. 8-128 chars of letters, numbers, `_`, `.`, `:` or `-`. Retrying the same key replays the original response byte-for-byte; reusing it with a different body returns `IDEMPOTENCY_KEY_REUSED_WITH_DIFFERENT_BODY`.",
        "schema": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "workspaceType": {"type": "string", "enum": ["personal", "organization"]},
          "organizationId": {"type": "string", "nullable": true},
          "name": {"type": "string"},
          "websiteUrl": {"type": "string", "nullable": true},
          "description": {"type": "string", "nullable": true},
          "metadataLanguage": {"type": "string"},
          "status": {"type": "string"},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "archivedAt": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "websiteUrl": {"type": "string", "nullable": true},
          "description": {"type": "string", "maxLength": 2000},
          "metadataLanguage": {"type": "string", "enum": ["en", "ur"]}
        }
      },
      "Image": {
        "type": "object",
        "description": "Never includes a storage key.",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "originalFilename": {"type": "string"},
          "mimeType": {"type": "string"},
          "detectedMimeType": {"type": "string", "nullable": true},
          "detectedFormat": {"type": "string", "nullable": true},
          "sizeBytes": {"type": "integer"},
          "width": {"type": "integer", "nullable": true},
          "height": {"type": "integer", "nullable": true},
          "status": {"type": "string"},
          "isAnimated": {"type": "boolean", "nullable": true},
          "failureCode": {"type": "string", "nullable": true},
          "uploadedAt": {"type": "string", "format": "date-time", "nullable": true},
          "validatedAt": {"type": "string", "format": "date-time", "nullable": true},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      },
      "AuthorizeUploadsRequest": {
        "type": "object",
        "required": ["files"],
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": ["clientId", "originalFilename", "mimeType", "sizeBytes"],
              "properties": {
                "clientId": {"type": "string", "maxLength": 128, "description": "Caller-supplied id used to correlate this file across the response."},
                "originalFilename": {"type": "string", "maxLength": 255},
                "mimeType": {"type": "string", "maxLength": 100},
                "sizeBytes": {"type": "integer", "maximum": 26214400, "description": "25 MB per-file limit."}
              }
            }
          }
        }
      },
      "AuthorizeUploadsEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelopeBase"},
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "results": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "clientId": {"type": "string"},
                        "imageId": {"type": "string", "format": "uuid"},
                        "uploadUrl": {"type": "string", "format": "uri"},
                        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
                        "expiresAt": {"type": "string", "format": "date-time"}
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ConfirmUploadEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelopeBase"},
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "imageId": {"type": "string", "format": "uuid"},
                  "status": {"type": "string"},
                  "idempotent": {"type": "boolean"}
                }
              }
            }
          }
        ]
      },
      "CreateProcessingJobRequest": {
        "type": "object",
        "properties": {
          "operation": {"type": "string", "enum": ["optimize", "resize", "convert"], "description": "Defaults to optimize when omitted."},
          "preset": {"type": "string", "maxLength": 64, "nullable": true, "description": "Resize preset (e.g. 256/512/1024/2048) or conversion target format."}
        }
      },
      "ProcessingJob": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "imageId": {"type": "string", "format": "uuid"},
          "operation": {"type": "string"},
          "preset": {"type": "string", "nullable": true},
          "status": {"type": "string"},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      },
      "ProcessingJobEnvelope": {
        "allOf": [{"$ref": "#/components/schemas/SuccessEnvelopeBase"}, {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/ProcessingJob"}}}]
      },
      "CreateMetadataGenerationRequest": {
        "type": "object",
        "properties": {"language": {"type": "string", "minLength": 2, "maxLength": 10}}
      },
      "MetadataEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelopeBase"},
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "altText": {"type": "string"},
                  "title": {"type": "string"},
                  "caption": {"type": "string"},
                  "description": {"type": "string"},
                  "filenameSuggestion": {"type": "string"},
                  "language": {"type": "string"},
                  "approvedAt": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        ]
      },
      "CreateExportRequest": {
        "type": "object",
        "required": ["packageKind"],
        "properties": {
          "packageKind": {"type": "string", "enum": ["csv", "json", "zip", "wordpress", "shopify", "webflow"]},
          "sourceFilter": {"type": "string", "enum": ["approved", "draft", "reviewed"], "description": "Defaults to approved."},
          "language": {"type": "string", "minLength": 2, "maxLength": 10},
          "imageIds": {"type": "array", "maxItems": 100, "items": {"type": "string", "format": "uuid"}},
          "includeImages": {"type": "boolean"},
          "includeCsv": {"type": "boolean"},
          "includeJson": {"type": "boolean"},
          "includeTxt": {"type": "boolean"},
          "includeHtmlReport": {"type": "boolean"},
          "includeSidecars": {"type": "boolean"},
          "format": {"type": "string", "maxLength": 50, "nullable": true}
        }
      },
      "SuccessEnvelopeBase": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean", "enum": [true]},
          "requestId": {"type": "string"},
          "meta": {"type": "object", "additionalProperties": true}
        }
      },
      "SuccessEnvelope": {
        "allOf": [{"$ref": "#/components/schemas/SuccessEnvelopeBase"}, {"type": "object", "properties": {"data": {}}}]
      },
      "ProjectEnvelope": {
        "allOf": [{"$ref": "#/components/schemas/SuccessEnvelopeBase"}, {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Project"}}}]
      },
      "ProjectListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelopeBase"},
          {"type": "object", "properties": {"data": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Project"}}}}}}
        ]
      },
      "ImageEnvelope": {
        "allOf": [{"$ref": "#/components/schemas/SuccessEnvelopeBase"}, {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Image"}}}]
      },
      "ImageListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/SuccessEnvelopeBase"},
          {"type": "object", "properties": {"data": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Image"}}}}}}
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean", "enum": [false]},
          "requestId": {"type": "string"},
          "error": {
            "type": "object",
            "properties": {
